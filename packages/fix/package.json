{
  "name": "@rgaa-source/fix",
  "version": "0.2.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "license": "MIT",
  "author": {
    "name": "Oussama Laribi",
    "url": "https://github.com/oussamaLaribi"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@rgaa-source/core": "^0.2.1"
  },
  "description": "Applies RGAA and WCAG accessibility fixes back to the source line a violation came from.",
